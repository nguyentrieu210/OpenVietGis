FROM python:3.13-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin libpq5 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv

COPY apps/api/pyproject.toml apps/api/uv.lock /app/apps/api/
COPY apps/api /app/apps/api
COPY modules /app/modules
COPY tools/migrate_official_modules.py /app/tools/migrate_official_modules.py
RUN uv sync --project /app/apps/api --locked --no-dev
RUN chmod -R a+rX /app/apps/api /app/modules /app/tools \
    && useradd --system --uid 10001 --create-home openvietgis \
    && install -d -o openvietgis -g openvietgis -m 0700 /var/lib/openvietgis/artifacts

USER openvietgis
EXPOSE 8000
CMD ["/app/apps/api/.venv/bin/uvicorn", "openvietgis_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
