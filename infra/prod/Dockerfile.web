FROM node:26-bookworm-slim AS builder
WORKDIR /app
RUN npm install --global pnpm@12.21.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY tools/check_node_runtime.mjs ./tools/check_node_runtime.mjs
# Dependency layer changes only when a workspace manifest or lockfile changes.
COPY packages/client-sdk/package.json ./packages/client-sdk/package.json
COPY packages/spatial-workspace/package.json ./packages/spatial-workspace/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/web-next/package.json ./apps/web-next/package.json
COPY modules/house_numbering/frontend/package.json ./modules/house_numbering/frontend/package.json
RUN pnpm validate:runtime && pnpm install --frozen-lockfile
COPY packages ./packages
COPY apps/web-next ./apps/web-next
COPY modules ./modules
RUN pnpm --filter @openvietgis/web-next build
# Vite copies public files with source modes; the nginx worker must read them.
RUN chmod -R a+rX /app/apps/web-next/dist

FROM nginx:1.27-alpine
COPY infra/prod/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web-next/dist /usr/share/nginx/html
EXPOSE 80
