  "workflows": {
    ".github/workflows/ci.yml": {
      "name": "CI",
      "job_ids": [
        "backend",
        "validate",
        "secrets"
      ],
      "trigger_block": "  push:\n    branches: [main, \"001-platform-foundation\", \"takeover/002-identity-tenancy\"]\n  pull_request:\n  workflow_dispatch:\n    inputs:\n      browser_only:\n        description: \"Focused browser diagnosis only; never a full acceptance gate\"\n        type: boolean\n        required: false\n        default: false",
      "concurrency_present": false,
      "command_step_names": [
        "Install Python dependencies",
        "Build native E08 backend for integration and browser tests",
        "Install system GDAL runtime for raster fixtures",
        "Validate Python, contracts, scope, architecture and docs",
        "Start dedicated test database and reference identity provider",
        "Record observed spatial test image",
        "Verify reference realm discovery before browser tests",
        "Apply guarded migrations and verify restricted runtime role",
        "Validate restricted-runtime integration, migration and performance",
        "Verify live synthetic Keycloak OIDC code and PKCE",
        "Install JavaScript dependencies",
        "Install Python dependencies",
        "Build native E08 backend for integration and browser tests",
        "Install system GDAL runtime for raster fixtures",
        "Install Chromium",
        "Start dedicated test database and reference identity provider",
        "Record observed spatial test image",
        "Verify reference realm discovery before browser tests",
        "Apply guarded migrations and verify restricted runtime role",
        "Test CAD and GIS draft review in Chromium",
        "Run the full Node 26 root validation workflow",
        "Upload Playwright diagnostics when root validation fails",
        "Validate Engine-First editor and cache regression",
        "Test canonical built workspace (synthetic API)",
        "Test MCP contracts and ticket lifecycle",
        "Run focused browser diagnosis",
        "Scan explicit synthetic test evidence",
        "Verify measured tenant timing evidence"
      ]
    },
    ".github/workflows/e06-e08-retention.yml": {
      "name": "E06 retention and E08 native integration",
      "job_ids": [
        "retained-postgis-contracts"
      ],
      "trigger_block": "  workflow_dispatch:\n  push:\n    branches: [\"064-**\"]\n    paths:\n      - \".github/workflows/e06-e08-retention.yml\"\n      - \"apps/api/**\"\n      - \"infra/dev/**\"\n      - \"tools/run_with_test_database.py\"\n      - \"tools/test_database.py\"\n  pull_request:\n    paths:\n      - \".github/workflows/e06-e08-retention.yml\"\n      - \"apps/api/**\"\n      - \"infra/dev/**\"\n      - \"tools/run_with_test_database.py\"\n      - \"tools/test_database.py\"",
      "concurrency_present": false,
      "command_step_names": [
        "Verify retained E06 and Rust-owned E08 under the restricted role"
      ]
    },
    ".github/workflows/e11-outbox.yml": {
      "name": "E11 Outbox Candidate",
      "job_ids": [
        "postgis-outbox"
      ],
      "trigger_block": "  push:\n    branches: [\"064-**\"]\n    paths:\n      - \"infra/rust-platform/e11/**\"\n      - \"apps/api-rust/**\"\n      - \"crates/ovg-storage/**\"\n      - \"crates/ovg-sync/**\"\n      - \"tests/rust-parity/e11/**\"\n      - \".github/workflows/e11-outbox.yml\"\n  pull_request:\n    paths:\n      - \"infra/rust-platform/e11/**\"\n      - \"apps/api-rust/**\"\n      - \"crates/ovg-storage/**\"\n      - \"crates/ovg-sync/**\"\n      - \"tests/rust-parity/e11/**\"\n      - \".github/workflows/e11-outbox.yml\"",
      "concurrency_present": false,
      "command_step_names": [
        "E11 activity cursor and SSE parity (FastAPI oracle vs Rust)",
        "E11 managed QGIS sync parity (FastAPI oracle vs Rust)",
        "E11 project collaboration REST parity (FastAPI oracle vs Rust)",
        "E11 organization chat REST parity (FastAPI oracle vs Rust)",
        "E11 SSE listener cap parity (FastAPI oracle vs Rust)",
        "E11 WebSocket presence parity (FastAPI oracle vs Rust)"
      ]
    },
    ".github/workflows/e15-retention.yml": {
      "name": "E15 retained Python module",
      "job_ids": [
