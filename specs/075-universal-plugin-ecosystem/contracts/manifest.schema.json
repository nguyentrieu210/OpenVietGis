{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed separately signed contribution envelope (not replacement v1 manifest)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publisher_id",
    "extension_key",
    "version",
    "manifest_digest",
    "host_api_range",
    "platforms",
    "permissions",
    "contribution_digest",
    "assets",
    "issued_at",
    "key_id"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "publisher_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "extension_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "host_api_range": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "android",
          "ios",
          "windows",
          "macos",
          "linux",
          "server"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "contribution_digest": {
      "$ref": "#/$defs/digest"
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "media_type",
          "size",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "media_type": {
            "type": "string",
            "maxLength": 128
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10485760
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "key_id": {
      "type": "string",
      "maxLength": 128
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "range"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
