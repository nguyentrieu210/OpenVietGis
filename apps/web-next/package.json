  },
  "dependencies": {
    "@openvietgis/client-sdk": "workspace:*",
    "@openvietgis/spatial-workspace": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "geotiff": "3.0.5",
    "h5wasm": "0.10.3",
    "laz-perf": "0.0.7",
    "maplibre-gl": "6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.5",
    "terra-draw": "1.40.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5"
  }
